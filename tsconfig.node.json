{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "registry.config.ts",
    "vite-plugins/**/*.ts",
    "presets/types.ts",
    "src/types/index.ts",
    "src/studio/source-types.ts"
  ]
}
